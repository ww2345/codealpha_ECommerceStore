<% layout("layout/boilerplate") -%>

  <link rel="stylesheet" href="/css/home.css" />

  <main class="home-page">

    <!-- Hero -->
    <section class="home-hero-carousel-section">
      <div id="homeHeroCarousel" class="carousel slide carousel-fade home-hero-carousel" data-bs-ride="carousel">
        <div class="carousel-indicators">
          <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="0" class="active"
            aria-current="true" aria-label="Slide 1"></button>
          <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
          <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        <div class="carousel-inner">
          <div class="carousel-item active">
            <div class="hero-slide hero-slide-1">
              <div class="container">
                <div class="hero-content row align-items-center g-4">
                  <div class="col-12 col-lg-7">
                    <div class="hero-kicker">
                      <span class="hero-kicker-dot"></span>
                      New season deals are live
                    </div>
                    <h1 class="display-5 fw-bold hero-title">Shop smart. Save more.</h1>
                    <p class="lead hero-subtitle text-body-secondary mb-4">
                      Discover trending products across electronics, fashion, home essentials, and more—fast delivery
                      included.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                      <a class="btn btn-primary btn-lg" href="#featured">
                        <i class="fa-solid fa-bolt me-2"></i>Shop featured
                      </a>

                    </div>
                  </div>

                  <div class="col-12 col-lg-5">
                    <div class="hero-image-placeholder" role="img" aria-label="Featured arrivals preview">
                      <% const arrivals=Array.isArray(heroArrivals) ? heroArrivals : []; %>
                        <div class="hero-arrivals-grid" aria-hidden="true">
                          <% if (arrivals.length===0) { %>
                            <div class="hero-arrival hero-arrival-main">
                              <div class="hero-arrival-fallback"><i class="fa-solid fa-bag-shopping"></i></div>
                            </div>
                            <div class="hero-arrival">
                              <div class="hero-arrival-fallback"><i class="fa-solid fa-shirt"></i></div>
                            </div>
                            <div class="hero-arrival">
                              <div class="hero-arrival-fallback"><i class="fa-solid fa-laptop"></i></div>
                            </div>
                            <% } else { %>
                              <% arrivals.forEach((p, idx)=> { %>
                                <% const arrivalHref=p.category ? ("/Ecommerce/home/products?category=" + encodeURIComponent(p.category))
                                  : " /Ecommerce/home/products"; %>
                                  <a class="hero-arrival <%= idx === 0 ? 'hero-arrival-main' : '' %>"
                                    href="<%= arrivalHref %>">
                                    <% if (p.imageUrls && p.imageUrls.length) { %>
                                      <img class="hero-arrival-img" src="<%= p.imageUrls[0] %>" alt="<%= p.title %>">
                                      <% } else { %>
                                        <div class="hero-arrival-fallback"><i class="fa-solid fa-bag-shopping"></i>
                                        </div>
                                        <% } %>
                                  </a>
                                  <% }) %>
                                    <% } %>
                        </div>
                        <div class="hero-image-placeholder-inner">
                          <div class="hero-image-placeholder-icon">
                            <i class="fa-solid fa-bag-shopping"></i>
                          </div>
                          <div class="hero-image-placeholder-title">Featured arrivals</div>
                          <div class="hero-image-placeholder-subtitle text-body-secondary small">
                            New deals on top categories
                          </div>
                          <a href="#featured" class="btn btn-outline-primary home-hero-image-cta">
                            Shop now
                          </a>
                        </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>



          <div class="carousel-item">
            <div class="hero-slide hero-slide-3">
              <div class="container">
                <div class="hero-content row align-items-center g-4">
                  <div class="col-12 col-lg-7">
                    <div class="hero-kicker">
                      <span class="hero-kicker-dot"></span>
                      Trusted checkout experience
                    </div>
                    <h2 class="fw-bold hero-title">Secure payments. Easy returns.</h2>
                    <p class="lead hero-subtitle text-body-secondary mb-4">
                      Smooth ordering with guaranteed support and hassle-free returns.
                    </p>
                    <div class="d-flex flex-wrap gap-2">

                      <a class="btn btn-outline-primary btn-lg" href="#testimonials">
                        <i class="fa-solid fa-star me-2"></i>Read reviews
                      </a>
                    </div>
                  </div>

                  <div class="col-12 col-lg-5">
                    <div class="hero-metrics card shadow-sm">
                      <div class="card-body p-3 p-md-4">
                        <div class="home-metric">
                          <div class="home-metric-icon"><i class="fa-solid fa-truck-fast"></i></div>
                          <div>
                            <div class="home-metric-title">Fast delivery</div>
                            <div class="text-body-secondary small">1–3 days in most areas</div>
                          </div>
                        </div>
                        <hr class="home-metric-divider my-3" />
                        <div class="home-metric">
                          <div class="home-metric-icon"><i class="fa-solid fa-lock"></i></div>
                          <div>
                            <div class="home-metric-title">Protected checkout</div>
                            <div class="text-body-secondary small">Encrypted payments</div>
                          </div>
                        </div>
                        <hr class="home-metric-divider my-3" />
                        <div class="home-metric">
                          <div class="home-metric-icon"><i class="fa-solid fa-rotate-left"></i></div>
                          <div>
                            <div class="home-metric-title">30-day returns</div>
                            <div class="text-body-secondary small">No stress, just support</div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev"
          aria-label="Previous slide">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="next"
          aria-label="Next slide">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
      </div>
    </section>

    <!-- Value props -->
    <section class="home-value-props container my-4">
      <div class="row g-3">
        <div class="col-12 col-md-4">
          <div class="value-prop card h-100 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="value-prop-icon"><i class="fa-solid fa-truck-fast"></i></div>
              <div>
                <div class="fw-semibold">Fast delivery</div>
                <div class="text-body-secondary small">Across India</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="value-prop card h-100 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="value-prop-icon"><i class="fa-solid fa-credit-card"></i></div>
              <div>
                <div class="fw-semibold">Secure payments</div>
                <div class="text-body-secondary small">Multiple options</div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="value-prop card h-100 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="value-prop-icon"><i class="fa-solid fa-rotate-left"></i></div>
              <div>
                <div class="fw-semibold">Easy returns</div>
                <div class="text-body-secondary small">30-day policy</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Categories -->
    <section id="categories" class="home-categories container mb-4">
      <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
          <h2 class="h4 mb-1">Browse Categories</h2>
          <div class="text-body-secondary small">Pick a section to discover products</div>
        </div>

      </div>

      <div class="row g-3">

        <div class="col-6 col-md-4 col-lg-3">
          <a class="home-category-card card h-100 shadow-sm text-decoration-none"
            href="/Ecommerce/home/products?category=Fashion">
            <div class="card-body d-flex align-items-start gap-3">
              <div class="home-category-icon bg-info bg-opacity-10"><i class="fa-solid fa-shirt"></i></div>
              <div>
                <div class="fw-semibold">Fashion</div>
                <div class="text-body-secondary small">Men, women & kids</div>
              </div>
            </div>
          </a>
        </div>

        <div class="col-6 col-md-4 col-lg-3">
          <a class="home-category-card card h-100 shadow-sm text-decoration-none"
            href="/Ecommerce/home/products?category=Beauty">
            <div class="card-body d-flex align-items-start gap-3">
              <div class="home-category-icon bg-warning bg-opacity-10"><i class="fa-solid fa-wand-magic-sparkles"></i>
              </div>
              <div>
                <div class="fw-semibold">Beauty</div>
                <div class="text-body-secondary small">Skincare & grooming</div>
              </div>
            </div>
          </a>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
          <a class="home-category-card card h-100 shadow-sm text-decoration-none"
            href="/Ecommerce/home/products?category=Computers">
            <div class="card-body d-flex align-items-start gap-3">
              <div class="home-category-icon bg-primary bg-opacity-10"><i class="fa-solid fa-laptop"></i></div>
              <div>
                <div class="fw-semibold">Computers</div>
                <div class="text-body-secondary small">Laptops & accessories</div>
              </div>
            </div>
          </a>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
          <a class="home-category-card card h-100 shadow-sm text-decoration-none"
            href="/Ecommerce/home/products?category=Sports">
            <div class="card-body d-flex align-items-start gap-3">
              <div class="home-category-icon bg-info bg-opacity-10"><i class="fa-solid fa-bicycle"></i></div>
              <div>
                <div class="fw-semibold">Sports</div>
                <div class="text-body-secondary small">Fitness & outdoor gear</div>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Featured products -->
    <section id="featured" class="home-featured container mb-4">
      <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
          <h2 class="h4 mb-1">Featured Products</h2>
          <div class="text-body-secondary small">Handpicked bestsellers</div>
        </div>

      </div>

      <div class="row g-3">
        <% const featured=Array.isArray(productData) ? productData : []; %>
          <% if (featured.length===0) { %>
            <div class="col-12">
              <div class="alert alert-secondary mb-0">No products found in database.</div>
            </div>
            <% } %>

              <% featured.forEach((p, idx)=> { %>
                <div class="col-12 col-md-6 col-lg-4">
                  <div class="card home-product-card h-100 shadow-sm">
                    <div class="home-product-media <%= (p.imageUrls && p.imageUrls.length) ? 'has-image' : '' %>">
                      <% if (p.imageUrls && p.imageUrls.length) { %>
                        <img class="home-product-img" src="<%= p.imageUrls[0] %>" alt="<%= p.title %>">
                        <% } else { %>
                          <div class="home-product-icon <%= (idx % 2 === 1) ? 'bg-accent2' : '' %>">
                            <i class="fa-solid fa-bag-shopping"></i>
                          </div>
                          <% } %>
                            <div class="home-product-badge <%= (idx % 2 === 1) ? 'home-product-badge-alt' : '' %>">
                              Featured</div>
                    </div>
                    <div class="card-body p-3">
                      <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                          <div class="fw-semibold">
                            <%= p.title %>
                          </div>
                          <div class="text-body-secondary small">
                            <%= p.description || "" %>
                          </div>
                        </div>
                        <div class="home-product-price">₹<%= (typeof p.price==='number' ? p.price : Number(p.price ||
                            0)).toLocaleString('en-IN') %>
                        </div>
                      </div>
                      <form class="mt-3 d-grid" action="/Ecommerce/home/cart/add/<%= p._id %>" method="POST">
                        <input type="hidden" name="quantity" value="1">
                        <input type="hidden" name="returnTo" value="<%= currentPath || '/Ecommerce/home' %>">
                        <button class="btn btn-sm btn-outline-primary w-100" type="submit">
                          <i class="fa-solid fa-cart-plus me-2"></i>Add to cart
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
                <% }) %>
      </div>
    </section>

    <!-- Deals -->
    <section id="deals" class="home-deals container mb-4">
      <div class="row g-3 align-items-stretch">
        <div class="col-12 col-lg-5">
          <div class="card home-deals-banner h-100 shadow-sm">
            <div class="card-body p-4 p-md-5">
              <div class="d-flex align-items-center gap-2 mb-3">
                <span class="home-deals-pill"><i class="fa-solid fa-fire me-1"></i>Deal of the day</span>
              </div>
              <h3 class="fw-bold mb-2">Smart deals for everyday needs</h3>
              <p class="text-body-secondary mb-4">
                Choose from limited offers in electronics, fashion, home, and more.
              </p>
              <a class="btn btn-primary w-100 btn-lg" href="#featured">
                <i class="fa-solid fa-bag-shopping me-2"></i>Shop deals
              </a>

            </div>
          </div>
        </div>

        <div class="col-12 col-lg-7">
          <div class="card home-deals-list h-100 shadow-sm">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-end mb-3">
                <div>
                  <h3 class="h5 mb-1">Quick picks</h3>
                  <div class="text-body-secondary small">Small picks, big value</div>
                </div>
                <!-- Quick pick section  -->
              </div>
              <div class="row g-3">
                <% const quick=Array.isArray(quickPicks) ? quickPicks : []; %>
                  <% if (quick.length===0) { %>
                    <div class="col-12">
                      <div class="alert alert-secondary mb-0">No quick picks available.</div>
                    </div>
                    <% } %>

                      <% quick.forEach((p)=> { %>
                        <div class="col-12 col-md-6">
                          <div class="home-deal-item card h-100">
                            <div class="card-body p-3">
                              <div class="d-flex align-items-start justify-content-between gap-3">
                                <div class="d-flex align-items-start gap-3">
                                  <div
                                    class="home-deal-thumb <%= (p.imageUrls && p.imageUrls.length) ? 'has-image' : '' %>">
                                    <% if (p.imageUrls && p.imageUrls.length) { %>
                                      <img class="home-deal-img" src="<%= p.imageUrls[0] %>" alt="<%= p.title %>">
                                      <% } else { %>
                                        <i class="fa-solid fa-bag-shopping"></i>
                                        <% } %>
                                  </div>
                                  <div>
                                    <div class="fw-semibold">
                                      <%= p.title %>
                                    </div>
                                    <div class="text-body-secondary small">
                                      <%= p.description || "" %>
                                    </div>
                                  </div>
                                </div>
                                <div class="home-deal-item-price">
                                  ₹<%= (typeof p.price==='number' ? p.price : Number(p.price ||
                                    0)).toLocaleString('en-IN') %>
                                </div>
                              </div>
                              <form class="mt-3 d-grid" action="/Ecommerce/home/cart/add/<%= p._id %>" method="POST">
                                <input type="hidden" name="quantity" value="1">
                                <input type="hidden" name="returnTo" value="<%= currentPath || '/Ecommerce/home' %>">
                                <button class="btn btn-sm btn-outline-primary w-100" type="submit">
                                  <i class="fa-solid fa-cart-plus me-2"></i>Add to cart
                                </button>
                              </form>
                            </div>
                          </div>
                        </div>
                        <% }) %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section id="testimonials" class="home-testimonials container mb-4">
      <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
          <h2 class="h4 mb-1">Customers Love Us</h2>
          <div class="text-body-secondary small">A few words from happy shoppers</div>
        </div>

      </div>

      <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm home-quote">
            <div class="card-body p-4">
              <div class="home-quote-stars">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              </div>
              <p class="mb-3 text-body-secondary">
                The homepage looks premium and the product cards feel like a real store. Great UI foundation.
              </p>
              <div class="fw-semibold">Aarav S.</div>
              <div class="text-body-secondary small">Verified buyer</div>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm home-quote">
            <div class="card-body p-4">
              <div class="home-quote-stars">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              </div>
              <p class="mb-3 text-body-secondary">
                Love the dark theme and the spacing. Navbar and footer match perfectly across pages.
              </p>
              <div class="fw-semibold">Sara K.</div>
              <div class="text-body-secondary small">Verified buyer</div>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm home-quote">
            <div class="card-body p-4">
              <div class="home-quote-stars">
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              </div>
              <p class="mb-3 text-body-secondary">
                The featured section is clean and modern. This is exactly the vibe I wanted for my store.
              </p>
              <div class="fw-semibold">Rahul P.</div>
              <div class="text-body-secondary small">Verified buyer</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Brands -->
    <section class="home-brands container pb-5">
      <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
          <h2 class="h4 mb-1">Popular Brands</h2>
          <div class="text-body-secondary small">Trusted by shoppers</div>
        </div>

      </div>

      <div class="row g-3">
        <div class="col-6 col-md-4 col-lg-3">
          <div class="brand-chip card h-100 shadow-sm text-center">
            <div class="brand-chip-inner">Astra</div>
          </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="brand-chip card h-100 shadow-sm text-center">
            <div class="brand-chip-inner">Nova</div>
          </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="brand-chip card h-100 shadow-sm text-center">
            <div class="brand-chip-inner">Orbit</div>
          </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="brand-chip card h-100 shadow-sm text-center">
            <div class="brand-chip-inner">Vanta</div>
          </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="brand-chip card h-100 shadow-sm text-center">
            <div class="brand-chip-inner">Lumen</div>
          </div>
        </div>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="brand-chip card h-100 shadow-sm text-center">
            <div class="brand-chip-inner">Sparq</div>
          </div>
        </div>
      </div>
    </section>

    <footer class="home-footer pt-4 mt-2 border-top text-body-secondary small container">
      © <%= new Date().getFullYear() %> E-Commerce Store — Built with Express + EJS
    </footer>
  </main>
